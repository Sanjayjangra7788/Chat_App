{
  "name": "mern-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/server.js", 
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm start --prefix client",
    "server": "nodemon server/server.js",
    "build": "npm run client-build && npm run server-build",
    "client-build": "react-scripts build --prefix client",
    "server-build": "echo 'Backend build' && exit 0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "^5.0.0",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "concurrently": "^6.2.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.15"
  }
}
